<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CarManagerApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:CarManagerApp"
    Shell.FlyoutBehavior="Disabled">

    <Shell.Resources>
        <ResourceDictionary>
            <Style TargetType="Shell" ApplyToDerivedTypes="True">
                <Setter Property="Shell.BackgroundColor" Value="#0F1117" />
                <Setter Property="Shell.ForegroundColor" Value="#FFFFFF" />
                <Setter Property="Shell.TitleColor" Value="#FFFFFF" />
                <Setter Property="Shell.NavBarHasShadow" Value="False" />
            </Style>
        </ResourceDictionary>
    </Shell.Resources>

    <ShellContent
        Title="My Garage"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

</Shell>
